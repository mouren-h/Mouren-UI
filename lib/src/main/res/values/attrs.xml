        <attr name="sb_uncheckcircle_width" format="dimension"/>
        <attr name="sb_uncheckcircle_radius" format="dimension"/>
        <attr name="sb_shadow_radius" format="dimension"/>
        <attr name="sb_shadow_offset" format="dimension"/>
