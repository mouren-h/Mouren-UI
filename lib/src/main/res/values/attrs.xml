        <attr name="sb_uncheck_color" format="color"/>
        <attr name="sb_checked_color" format="color"/>
        <attr name="sb_border_width" format="dimension"/>
        <attr name="sb_checkline_color" format="color"/>
        <attr name="sb_checkline_width" format="dimension"/>
        <attr name="sb_button_color" format="color"/>
        <attr name="sb_uncheckbutton_color" format="color"/>
        <attr name="sb_checkedbutton_color" format="color"/>
        <attr name="sb_effect_duration" format="integer" min="0"/>
